# Example configuration. Copy to .env and fill in. Never commit real values.
# Variable names only, with safe placeholder values.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/photoalbum

# --- Server ---
PORT=5000
NODE_ENV=development
# Number of trusted reverse-proxy hops in front of the app (0 = none).
TRUST_PROXY_HOPS=0

# --- Stack Auth ---
STACK_PROJECT_ID=your-stack-project-id
# STACK_API_URL=https://api.stack-auth.com

# --- CORS ---
# Comma-separated list of allowed frontend origins (exact origins, no wildcard).
# The Vite dev server runs on 127.0.0.1:8080.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080

# --- Terms consent ---
# Current terms version. Placeholder until the real Terms/Privacy text is defined.
TERMS_VERSION=placeholder-0

# --- Optional limits (defaults apply if unset) ---
# BODY_LIMIT=100kb
# MAX_UPLOAD_BYTES=10485760
# RATE_LIMIT_GENERAL=300
# RATE_LIMIT_AUTH_FAILURES=20
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_WRITE=60
# Number of cover images returned per album by GET /albums/summaries (default 5, maximum 10).
# ALBUM_COVER_IMAGES=5

# --- Cloudinary (current image storage; to be replaced by OCI Object Storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
